module angry_eceScreen_top (CLOCK_50, KEY, SW, LEDR, HEX0, HEX1, HEX2, HEX3, HEX4, HEX5, GPIO_1, VGA_R, VGA_G, VGA_B, VGA_HS, VGA_VS, VGA_BLANK_N, VGA_SYNC_N, VGA_CLK);
    input wire CLOCK_50; 
    input wire [3:0] KEY; 
    input wire [9:0] SW;
    output wire [9:0] LEDR;
    output wire [6:0] HEX0, HEX1, HEX2, HEX3, HEX4, HEX5;


    inout wire [35:0] GPIO_1;

    output reg [7:0] VGA_R;
    output reg [7:0] VGA_G;
    output reg [7:0] VGA_B;
    output reg VGA_HS;
    output reg VGA_VS;
    output reg VGA_BLANK_N;
    output wire VGA_SYNC_N;
    output wire VGA_CLK;


    localparam Num_blocks = 12, Num_pigs = 3, Num_dots = 10;
    localparam full_power = 15;
    localparam Screen_TITLE = 3'd0,Screen_LOAD = 3'd1, Screen_AIM = 3'd2, Screen_FLY = 3'd3, Screen_SETTLE = 3'd4,Screen_CLEAR = 3'd5, Screen_OVER = 3'd6, Screen_WIN = 3'd7;

    wire clk = CLOCK_50;

    //reset: (KEY0, active low)
    reg [2:0] reset_sync = 3'b111;
    always @(posedge clk) reset_sync <= {reset_sync[1:0],~KEY[0]};
    wire reset = reset_sync[2];

    reg [1:0] k1_sync = 2'b11;
    reg k1_armed = 1'b1;
    reg [17:0] k1_quiet = 18'd0;
    reg key_press = 1'b0;
    always @(posedge clk) begin
        k1_sync <= {k1_sync[0], KEY[1]}; 
        key_press <= 1'b0;
        if (!k1_sync[1]) begin 
            k1_quiet<=18'd0;

            if (k1_armed) begin
                key_press <=1'b1;
                k1_armed <=1'b0;
            end
        end else if (!k1_armed) begin
            k1_quiet <= k1_quiet+ 18'd1;
            if (&k1_quiet) k1_armed <= 1'b1;
        end
    end

    wire pixels_enabled, visible, hScreen_n, vScreen_n, frame_tick;
    wire [9:0] h,v; 
    vga_timing u_vga (.clk(clk), .reset(1'b0), .pixels_enabled(pixels_enabled), .h(h), .v(v),.visible(visible), .hsync_n(hScreen_n), .vsync_n(vScreen_n), .frame_tick(frame_tick)
    );

    wire [3:0] sling_value;
    wire sling_seen;
    slingshot_rx u_sling (.CLOCK_50(clk), .rx_pin(GPIO_1[0]),.hex_value(sling_value), .seen(sling_seen));
    
    
    wire [3:0] power = sling_seen ? sling_value : SW[3:0];

    wire [2:0] state;
    wire [1:0] level, bird; 

    wire [9:0] ptScreen_add;

    wire new_game,game_end;

    wire bird_vis;
    wire signed [9:0] bird_x, bird_y;

    wire [2:0] waiting; 
    wire [Num_blocks*9-1:0] blk_x_f; 
    wire [Num_blocks*8-1:0] blk_y_f;
    wire [Num_blocks-1:0] blk_horiz, blk_alive;

    wire [Num_pigs*9-1:0] pig_x_f; 
    wire [Num_pigs*8-1:0] pig_y_f;
    wire [Num_pigs-1:0] pig_alive;

    wire [Num_dots*9-1:0] dot_x_f; 
    wire [Num_dots*8-1:0] dot_y_f;
    wire [Num_dots-1:0] dot_on;

    wire exp_on;
    wire [8:0] exp_x; 
    wire [7:0] exp_y;
    wire [5:0] exp_r;

    wire [Num_blocks-1:0] blk_flash;
    wire [Num_pigs-1:0] pig_flash;

    game_logic #(.Num_blocks(Num_blocks), .Num_pigs(Num_pigs),.Num_dots(Num_dots),.full_power(full_power)) u_game (
        .clk(clk),.reset(reset), .frame_tick(frame_tick), .key_press(key_press),
        .sw(SW), .power(power),

        .state(state), .level(level),
        .ptScreen_add(ptScreen_add), .new_game(new_game), .game_end(game_end),
        .bird(bird), .bird_vis(bird_vis), .bird_x(bird_x), .bird_y(bird_y), .waiting(waiting),
        .blk_x_f(blk_x_f), .blk_y_f(blk_y_f), .blk_horiz(blk_horiz), .blk_alive(blk_alive),
        .pig_x_f(pig_x_f), .pig_y_f(pig_y_f), .pig_alive(pig_alive),
        .dot_x_f(dot_x_f), .dot_y_f(dot_y_f), .dot_on(dot_on),
        .exp_on(exp_on), .exp_x(exp_x), .exp_y(exp_y), .exp_r(exp_r),
        .blk_flash(blk_flash), .pig_flash(pig_flash));


    wire [9:0] score,high_score; 
    score_tracker u_score (.clk(clk),.new_game(new_game),.add(ptScreen_add), .game_end(game_end),.score(score), .high_score(high_score));

    wire playing = (state == Screen_AIM) || (state == Screen_FLY) || (state == Screen_SETTLE);
    wire show_picture = !playing;

    wire [11:0] world_rgb, pic_rgb;


    renderer #(.Num_blocks(Num_blocks), .Num_pigs(Num_pigs), .Num_dots(Num_dots)) u_draw (
        .clk(clk), .h(h),.v(v), 
        .blk_x_f(blk_x_f),  .blk_y_f(blk_y_f), .blk_horiz(blk_horiz),.blk_alive(blk_alive),
        .pig_x_f(pig_x_f), .pig_y_f(pig_y_f), .pig_alive(pig_alive),
        .blk_flash(blk_flash), .pig_flash(pig_flash),
        .bird_x(bird_x), .bird_y(bird_y), .bird_type(bird), .bird_vis(bird_vis), .waiting(waiting),
        .dot_x_f(dot_x_f), .dot_y_f(dot_y_f), .dot_on(dot_on),
        .exp_on(exp_on), .exp_x(exp_x), .exp_y(exp_y), .exp_r(exp_r),
        .line_en({5'b00000, playing}),
        .line_msg({20'd0, 4'd6 + {2'b00, level}}),
        .dim(1'b0),
        .rgb(world_rgb)
    );
    screen_rom u_scr (.clk(clk), .h(h), .v(v), .screen(state), .rgb(pic_rgb));

    wire [11:0] rgb = show_picture ? pic_rgb : world_rgb;


    always @(posedge clk)begin
        if (pixels_enabled) begin
            VGA_R <= visible ? {rgb[11:8],rgb[11:8]} : 8'd0; 
            VGA_G <= visible ? {rgb[7:4], rgb[7:4]} : 8'd0;
            VGA_B <= visible ? {rgb[3:0],rgb[3:0]} : 8'd0; 
            VGA_HS <= hScreen_n;
            VGA_VS <= vScreen_n;
            VGA_BLANK_N <= visible;
        end
    end
    assign VGA_CLK = pixels_enabled;
    assign VGA_SYNC_N = 1'b0;

    reg [3:0] shown_power = 4'd0;
    always @(posedge clk) begin
        if (state == Screen_AIM) shown_power <= power;
        end

    wire [3:0] s2 = score / 10'd100, s1 = (score / 10'd10) % 10'd10, s0 = score % 10'd10;
    wire [3:0] h2 = high_score / 10'd100, h1 = (high_score / 10'd10) % 10'd10, h0 = high_score % 10'd10;

    wire [6:0] seg0, seg1, seg2, seg3, seg4, seg5;
    char_to_7seg d0 (playing ? shown_power : h0, seg0);
    char_to_7seg d1 (h1, seg1);
    char_to_7seg d2 (h2, seg2);
    char_to_7seg d3 (s0, seg3);
    char_to_7seg d4 (s1, seg4);
    char_to_7seg d5 (s2, seg5);

    assign HEX0 = seg0;
    assign HEX1 = playing ? 7'h7F : seg1;
    assign HEX2 = playing ? 7'h7F : seg2;
    assign HEX3 = seg3;
    assign HEX4 = seg4;
    assign HEX5 = seg5;

    wire [2:0] birdScreen_left = (state == Screen_TITLE) ? 3'b000 :
        (bird == 2'd0) ? 3'b111 : (bird == 2'd1) ? 3'b011 : 3'b001;
    assign LEDR = {(level == 2'd2), (level == 2'd1), 4'd0, sling_seen, birdScreen_left};
endmodule